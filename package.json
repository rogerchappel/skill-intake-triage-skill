{
  "name": "skill-intake-triage-skill",
  "version": "0.1.0",
  "description": "Local-first intake triage for choosing reusable agent skills safely.",
  "type": "module",
  "bin": {
    "skill-intake-triage-skill": "bin/skill-intake-triage-skill.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "smoke": "node bin/skill-intake-triage-skill.js --fixture fixtures/intake-request.json",
    "lint": "npm run check",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "skill-routing",
    "triage",
    "dry-run"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/skill-intake-triage-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/skill-intake-triage-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/skill-intake-triage-skill#readme",
  "files": [
    "bin",
    "src",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
